#!/usr/bin/env bash
# Open Kindle in its own window.
#   kindle           open Kindle (the first open after login starts Android in the background)
#   kindle --sign-in open Kindle at Amazon's sign-in page (opening Kindle does this by itself
#                    until you're signed in)
#   kindle --stop    shut Android down and free its memory
#   kindle --status  show whether Android is running, paused or stopped
# The window is scrcpy showing a virtual Android screen that resizes with it, so Kindle reflows
# when the window is tiled, resized or made fullscreen. While the window is closed, Android stays
# loaded but paused (no CPU use), so Kindle reopens in about a second.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
# shellcheck source=lib.sh
source "$here/lib.sh"

# Desktop notifications: notify TITLE [BODY], with Kindle's icon.
notify() {
  command -v notify-send >/dev/null || return 0
  local icon=()
  [[ ! -f $KINDLE_ICON ]] || icon=(-i "$KINDLE_ICON")
  notify-send -a Kindle "${icon[@]}" "$@" || true
}
fail() { # TITLE [BODY]
  notify -u critical "$@"
  die "$*"
}
# For messages: the command as installed, and the state folder as people would type it.
CMD=$(state_get command)
if [[ -z $CMD ]]; then
  if [[ $here == "$PKG_DIR" ]]; then CMD=kindle-for-linux; else CMD=kindle; fi
fi
STATE_DISPLAY=${STATE_DIR/#$HOME/\~}

kfl_version() {
  if [[ -r $here/VERSION ]]; then cat "$here/VERSION"; else echo dev; fi
}

usage() {
  cat <<EOF
Kindle for Linux $(kfl_version)

Usage: $CMD [OPTION]
  (no option)       open Kindle (runs one-time setup automatically if needed)
  --sign-in         open Kindle at Amazon's sign-in page
  --density <N|reset> set display density (72-640; smaller = smaller text, default 160x scale)
  --stop            shut Android down and free its memory
  --status          show whether Android is running, paused, or stopped
  --setup [ARGS]    run setup (accepts --check or --apk FILE)
  --verify [--bench] check the install and measure disk, memory, CPU, and open speed
  --uninstall       remove Kindle for Linux data and Android setup
  --version         show version
  --help            show this help
EOF
}

needs_setup() {
  [[ -n $(state_get backend) ]] || return 0
  if [[ $BACKEND == emulator ]]; then
    [[ -x $EMU_SDK/emulator/emulator ]] || return 0
  else
    command -v waydroid >/dev/null || return 0
  fi
  [[ -n $(scrcpy_bin) && -n $(adb_bin) ]] || return 0
  return 1
}

# Launch a script in a terminal window when started from an app menu (no TTY).
run_in_terminal() { # cmd [args...]
  # shellcheck disable=SC2016
  local wrap='"$1" "${@:2}"; rc=$?; if ((rc)); then printf "\nStopped (exit %d). Press Enter to close..." "$rc"; read -r _; fi'
  if command -v xdg-terminal-exec >/dev/null; then
    exec xdg-terminal-exec bash -c "$wrap" _ "$@"
  elif command -v x-terminal-emulator >/dev/null; then
    exec x-terminal-emulator -e bash -c "$wrap" _ "$@"
  elif command -v gnome-terminal >/dev/null; then
    exec gnome-terminal -- bash -c "$wrap" _ "$@"
  elif command -v ptyxis >/dev/null; then
    exec ptyxis -- bash -c "$wrap" _ "$@"
  elif command -v kgx >/dev/null; then
    exec kgx -- bash -c "$wrap" _ "$@"
  elif command -v konsole >/dev/null; then
    exec konsole -e bash -c "$wrap" _ "$@"
  elif command -v xfce4-terminal >/dev/null; then
    exec xfce4-terminal -x bash -c "$wrap" _ "$@"
  elif command -v foot >/dev/null; then
    exec foot bash -c "$wrap" _ "$@"
  elif command -v kitty >/dev/null; then
    exec kitty bash -c "$wrap" _ "$@"
  elif command -v alacritty >/dev/null; then
    exec alacritty -e bash -c "$wrap" _ "$@"
  elif command -v ghostty >/dev/null; then
    exec ghostty -e bash -c "$wrap" _ "$@"
  elif command -v wezterm >/dev/null; then
    exec wezterm start -- bash -c "$wrap" _ "$@"
  elif command -v tilix >/dev/null; then
    exec tilix -e bash -c "$wrap" _ "$@"
  elif command -v mate-terminal >/dev/null; then
    exec mate-terminal -x bash -c "$wrap" _ "$@"
  elif command -v lxterminal >/dev/null; then
    exec lxterminal -e bash -c "$wrap" _ "$@"
  elif command -v xterm >/dev/null; then
    exec xterm -e bash -c "$wrap" _ "$@"
  fi
  fail "Kindle needs one-time setup." "Open a terminal and run: $CMD --setup"
}

run_setup() {
  [[ -x $here/install.sh ]] || fail "Setup script is missing." "Reinstall kindle-for-linux."
  if [[ -t 0 || -t 1 || " $* " == *" --check "* ]]; then
    exec "$here/install.sh" "$@"
  else
    run_in_terminal "$here/install.sh" "$@"
  fi
}

# Amazon's sign-in page is marked secure (FLAG_SECURE), and Android blanks such windows out of
# screen captures, which is what Kindle's window shows. A patched scrcpy server
# (scrcpy-server/secure-display.patch) makes the virtual screen secure, so the page shows in
# Kindle's own window. That takes Android's system user (on the emulator via `adb root`; on
# Waydroid, where adbd refuses `adb root`, via an init service installed in Waydroid's overlay),
# and as the system user Android doesn't share its clipboard; so this "sign-in mode" is used only
# until you're signed in, with paste typed in as keystrokes (--legacy-paste). Then Kindle reopens
# in normal mode.
SECURE_SERVER=$here/scrcpy-server/scrcpy-server-secure
[[ -f $SECURE_SERVER ]] || SECURE_SERVER=$SCRCPY_DIR/scrcpy-server-secure
adb_system_bin() {
  if [[ -x $here/adb-system ]]; then
    echo "$here/adb-system"
  elif [[ -x $here/scrcpy-server/adb-system ]]; then
    echo "$here/scrcpy-server/adb-system"
  fi
}

# Get root inside Android (adb root) and print the serial to use from then on (emulator backend).
android_root() { # $1 = serial
  local s=$1
  if [[ $(kfl_adb -s "$s" shell id -u 2>/dev/null | tr -d '\r') == 0 ]]; then
    echo "$s"
    return 0
  fi
  [[ $(kfl_adb -s "$s" shell getprop ro.debuggable 2>/dev/null | tr -d '\r') == 1 ]] || return 1
  kfl_adb -s "$s" root >/dev/null 2>&1 || return 1
  sleep 2
  s=$(android_connect 30) || return 1
  [[ $(kfl_adb -s "$s" shell id -u 2>/dev/null | tr -d '\r') == 0 ]] || return 1
  echo "$s"
}

# Get Kindle to Amazon's sign-in page on Android's own (never shown) screen, where its controls
# can be found by their text; Kindle's window then brings it over. 0 = on the page, 1 = no "Sign
# In with Amazon" anywhere (already signed in), 2 = sign-in mode isn't possible here.
# Sets `serial` (elevated on the emulator) and `sign_in_size` to the window screen's size.
#
# Android recreates a screen whose size or density changes, and a sign-in screen recreated midway
# fails: Amazon then rejects the device registration ("InvalidValue"). So the page is opened at
# exactly the size and density of the screen in Kindle's window, which stays that size until
# you're signed in (the window scales it), and moves over unchanged.
prepare_sign_in() { # $1 = density
  [[ -f $SECURE_SERVER && $(scrcpy_bin) == "$SCRCPY_DIR/scrcpy" ]] || return 2
  if [[ $BACKEND == emulator ]]; then
    serial=$(android_root "$serial") || return 2
  else
    [[ -n $(adb_system_bin) ]] || return 2
    kfl_adb -s "$serial" shell \
      'test -x /system/bin/kfl-scrcpy-server -a -f /system/etc/init/kfl-scrcpy.rc -a -f /system/framework/kfl-scrcpy-server.jar' \
      >/dev/null 2>&1 || return 2
  fi
  local launch rc=0
  sign_in_size="$((900 * $1 / 160))x$((1100 * $1 / 160))"
  kfl_adb -s "$serial" shell am force-stop "$KINDLE_PKG" >/dev/null 2>&1 || true
  kfl_adb -s "$serial" shell wm size "$sign_in_size" >/dev/null 2>&1 || true
  set_display0_density "$serial" "$1" 0
  kfl_adb -s "$serial" logcat -c >/dev/null 2>&1 || true # watch_sign_in reads what follows
  launch=$(kfl_adb -s "$serial" shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$KINDLE_PKG" | tr -d '\r' | tail -n1)
  kfl_adb -s "$serial" shell am start --display 0 -n "$launch" >/dev/null 2>&1 || true
  open_sign_in_page "$serial" "$BACKEND" || rc=1
  return $rc
}

# Current, override, and physical density of Android's display 0.
display0_density_info() { # $1 = serial
  local out=""
  out=$(kfl_adb -s "$1" shell wm density 2>/dev/null | tr -d '\r' || true)
  awk -F': ' '
    /^Override/ { o = $2 + 0 }
    /^Physical/ { p = $2 + 0 }
    END { cur = (o ? o : p); printf "%d %d %d\n", cur, o, p }
  ' <<<"$out"
}

# Sync Android display 0's density before starting Kindle: Kindle converts its book font size table
# into raw pixels once at app startup (Application.onCreate) from display 0's metrics, then passes
# PIXEL sizes to the reader, ignoring the virtual display's DPI for book body text.
set_display0_density() { # $1 = serial, $2 = density, [$3 = force-stop Kindle if changed (1/0)]
  local cur=0
  read -r cur _ _ <<<"$(display0_density_info "$1")"
  [[ $cur =~ ^[0-9]+$ && $cur -eq $2 ]] && return 0
  if kfl_adb -s "$1" shell wm density "$2" >/dev/null 2>&1; then
    state_set display0_density "$2"
  fi
  [[ ${3:-0} != 1 ]] || kfl_adb -s "$1" shell am force-stop "$KINDLE_PKG" >/dev/null 2>&1 || true
}

# Android's own screen back to how it's kept outside sign-in.
restore_main_screen() { # [$1 = keep-density]
  if [[ $BACKEND == emulator ]]; then
    kfl_adb -s "$serial" shell wm size 160x100 >/dev/null 2>&1 || true
  else
    kfl_adb -s "$serial" shell wm size reset >/dev/null 2>&1 || true
  fi
  if [[ ${1:-} != keep-density ]]; then
    kfl_adb -s "$serial" shell wm density reset >/dev/null 2>&1 || true
    state_set display0_density ""
  fi
}

# Watch Kindle inside its virtual screen: if you back out of the app on Android, Android leaves
# scrcpy's virtual screen empty, so scrcpy would keep showing the last frozen frame. Once Kindle
# has been seen on that screen and then leaves it with no app left there, close scrcpy ($1).
watch_app() { # $1 = scrcpy pid, $2 = window log
  local disp="" seen=0 gone=0 line app
  while kill -0 "$1" 2>/dev/null; do
    if [[ -z $disp ]]; then
      disp=$(sed -n 's/.*\[server\] INFO: New display: .* (id=\([0-9]*\)).*/\1/p' "$2" 2>/dev/null | tail -n1)
    fi
    if [[ -n $disp ]]; then
      app=$(ADB_TIMEOUT=5 kfl_adb -s "$serial" shell dumpsys window displays 2>/dev/null | tr -d '\r' |
        awk -v d="Display: mDisplayId=$disp " '
          index($0, d) { in_d = 1; next }
          in_d && /Display: mDisplayId=/ { in_d = 0 }
          in_d && /mFocusedApp=/ { sub(/.*mFocusedApp=/, ""); app = $0 }
          END { print app }
        ')
      if [[ $app == *"$KINDLE_PKG/"* ]]; then
        seen=1
        gone=0
      elif ((seen)) && [[ $app == null ]]; then
        gone=$((gone + 1))
        if ((gone >= 2)); then
          kill "$1" 2>/dev/null || true
          return
        fi
      fi
    fi
    sleep 2
  done
}

# Watch a sign-in in Kindle's window. Once Amazon's page has gone and Kindle is back in front,
# Kindle registers this device with Amazon; its log says if that failed. Then close the window
# (scrcpy, $1) so Kindle reopens: in normal mode if signed in, else at the sign-in page again.
watch_sign_in() { # $1 = scrcpy pid
  local top seen=0 i retry
  while kill -0 "$1" 2>/dev/null; do
    top=$(kfl_adb -s "$serial" shell dumpsys activity activities 2>/dev/null | grep topResumedActivity || true)
    if [[ $top == *AuthPortalUIActivity* ]]; then
      seen=1
    elif ((seen)) && [[ $top == *"$KINDLE_PKG/"* && $top != *ThirdPartyUpgradePage* && $top != *TrialModeSignInActivity* ]]; then
      retry=0
      for i in 1 2 3 4 5 6; do # the registration takes a moment
        if kfl_adb -s "$serial" logcat -d 2>/dev/null | grep -q "AccountManagerLogic: Register error"; then
          echo sign-in >"$STATE_DIR/reopen"
          kill "$1" 2>/dev/null || true
          return
        fi
        sleep 1
        top=$(kfl_adb -s "$serial" shell dumpsys activity activities 2>/dev/null | grep topResumedActivity || true)
        if [[ $top == *AuthPortalUIActivity* ]]; then
          retry=1
          break
        fi
      done
      ((retry)) && continue
      kfl_adb -s "$serial" shell sync >/dev/null 2>&1 || true
      state_set "signed_in_$BACKEND" 1
      echo normal >"$STATE_DIR/reopen"
      kill "$1" 2>/dev/null || true
      return
    fi
    sleep 2
  done
}

open_kindle() { # $1 = auto (sign in first if Kindle isn't signed in yet) or sign-in
  mkdir -p "$STATE_DIR"
  local log=$STATE_DIR/window.log rc=0 density scale="" big=() mode=normal
  serial="" sign_in_size=""
  # One Kindle window at a time: a second one would open a second virtual screen. Waiting a few
  # seconds lets a window that is just closing finish (it pauses Android on its way out).
  exec 9>"$STATE_DIR/window.lock"
  flock -w 5 9 || exit 0

  case $(android_state) in
    STOPPED)
      notify "Starting Kindle…" "The first time after you log in, this takes about half a minute."
      start_android 240 || fail "Kindle couldn't start Android." "Details are in $STATE_DISPLAY."
      ;;
    FROZEN) android_wake ;;
  esac
  if ! serial=$(android_connect 15); then
    # Android is up but unreachable: after its core restarts (a crash), Waydroid's Android can
    # come back without its network. A fresh start fixes that.
    notify "Restarting Kindle…" "Android stopped responding, so Kindle is starting it again."
    stop_android
    start_android 240 || fail "Kindle couldn't restart Android." "Details are in $STATE_DISPLAY."
    serial=$(android_connect 60) || fail "Kindle can't reach Android." "Run \"$CMD --stop\", then open Kindle again."
  fi
  hide_waydroid_entry
  # Light or dark like the desktop (also followed live while the window is open, below).
  match_color_scheme "$serial"

  # Kindle's screen density: Android's standard 160 × the display's scale factor, so one Android
  # dp is one desktop pixel. (Kindle switches to its phone layout when the window is under 600 dp
  # tall; a larger density would push ordinary tiles there.) Waydroid derives 180 × scale from
  # the compositor: an override set with `wm density` wins. The emulator can't see the desktop,
  # so the scale is asked of the compositor; when that's unknown, the window stays in logical
  # pixels (right size, less sharp on scaled screens). KINDLE_DENSITY overrides either way.
  local owned_density="" over_d=0 phys_d=0
  owned_density=$(state_get display0_density)
  if [[ $BACKEND == emulator || $(display_mode) == x11 ]]; then
    scale=$(display_scale || true)
    density=$(awk -v s="${scale:-1}" 'BEGIN { print int(160 * s + 0.5) }')
  else
    scale=waydroid
    read -r _ over_d phys_d <<<"$(display0_density_info "$serial")"
    # Ignore an Override that this launcher set itself, so compositor scale changes and
    # `--density reset` still follow Physical density while keeping manual `wm density` overrides.
    if ((over_d > 0)) && [[ $over_d != "$owned_density" ]]; then
      density=$over_d
    elif ((phys_d > 0)); then
      density=$(awk -v p="$phys_d" 'BEGIN { print int(p * 160 / 180 + 0.5) }')
    fi
  fi
  [[ $density =~ ^[0-9]+$ && $density -gt 0 ]] || density=160
  local saved_density
  saved_density=$(state_get density)
  [[ $saved_density =~ ^[0-9]+$ && $saved_density -gt 0 ]] && density=$saved_density
  [[ ${KINDLE_DENSITY:-} =~ ^[0-9]+$ && ${KINDLE_DENSITY:-0} -gt 0 ]] && density=$KINDLE_DENSITY # bigger = larger text and buttons
  # Sized in real pixels, so on a scaled display Android draws at full resolution (sharp text).
  [[ -z $scale || $(display_mode) == x11 ]] || big=(SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1)

  if [[ $1 == sign-in || $(state_get "signed_in_$BACKEND") != 1 ]]; then
    local prep=0
    notify "Opening Amazon's sign-in page…"
    prepare_sign_in "$density" || prep=$?
    case $prep in
      0) mode=sign-in ;;
      1)
        state_set "signed_in_$BACKEND" 1 # nothing to sign in to: already signed in
        restore_main_screen keep-density
        [[ $1 != sign-in ]] || notify "You're already signed in to Amazon."
        ;;
      2)
        # No secure screen possible here (no root, or the distro's scrcpy): sign in in a window
        # showing Android's own screen instead.
        exec 9>&-
        sign_in_window
        return
        ;;
    esac
  fi

  follow_color_scheme "$serial" 9>&- &
  local color_pid=$!
  # Once the window closes: stop following (the PID is filled in now; the trap runs after this
  # function has returned), and pause Android. The pause lets scrcpy finish removing its screen.
  # shellcheck disable=SC2064
  trap "pkill -P $color_pid 2>/dev/null || true; kill $color_pid 2>/dev/null || true; sleep 2; android_sleep || true" EXIT

  local server=() extra=() adb_env=() screen pid reopen started drops=0 watcher=""
  : >"$log" # this window's log; a reconnect (below) adds to it
  while :; do
    server=() extra=() adb_env=(HOME="$ADB_HOME" ADB="$(adb_bin)")
    rm -f "$STATE_DIR/reopen"
    if [[ $mode == sign-in ]]; then
      server=(SCRCPY_SERVER_PATH="$SECURE_SERVER")
      # A fixed-size screen (see prepare_sign_in). Ctrl+V types the computer's clipboard: Android
      # won't share its clipboard with the system user, and Ctrl+V is only intercepted with
      # clipboard sync on (otherwise it reaches Android as is).
      screen=(--new-display="$sign_in_size/$density")
      extra=(--legacy-paste)
      if [[ $BACKEND == waydroid ]]; then
        adb_env=(HOME="$ADB_HOME" ADB="$(adb_system_bin)" REAL_ADB="$(adb_bin)")
        extra+=(--no-cleanup)
        notify "Sign in to Amazon" "Click \"Sign In with Amazon\", then sign in. Once you're signed in, Kindle opens your library."
      else
        notify "Sign in to Amazon" "Once you're signed in, Kindle opens your library."
      fi
    else
      set_display0_density "$serial" "$density" 1
      [[ ! -f $SCRCPY_DIR/scrcpy-server ]] || server=(SCRCPY_SERVER_PATH="$SCRCPY_DIR/scrcpy-server")
      screen=(--new-display=/"$density" --flex-display)
    fi
    # Android 15 (and Waydroid's fixed sign-in screen) would reserve a strip for system bars;
    # Kindle has its own back buttons (and right-click is Back).
    [[ $BACKEND != emulator && $mode != sign-in ]] || extra+=(--no-vd-system-decorations)
    # H.264 requires even dimensions, so odd tiled window widths (e.g. 941 px) get rounded down by
    # 1 px and blurred across the screen; default 8M/10s I-frames also leave static text soft
    # after transitions. VP8 allows 1x1 alignment (1:1 pixels) with crisp static keyframes (16M
    # stays within Android's 20M slow-cpu VP8 encoder cap).
    extra+=(--video-codec="${KINDLE_VIDEO_CODEC:-vp8}" --video-bit-rate="${KINDLE_BIT_RATE:-16M}" --video-codec-options=i-frame-interval=1)
    # scrcpy 5+ defaults to VA-API hardware decoding, whose DMA-BUF/EGL import fails on X11 (and
    # some GPU/driver setups), leaving a blank or green window. Software decoding costs next to
    # nothing for static book pages. KINDLE_HWDEC overrides (e.g. vaapi or auto).
    if [[ $(scrcpy_bin) == "$SCRCPY_DIR/scrcpy" ]] || "$(scrcpy_bin)" --help 2>/dev/null | grep -q -- '--hwdec'; then
      extra+=(--hwdec="${KINDLE_HWDEC:-disabled}")
    fi
    # stdbuf: scrcpy writes its log line by line (to a file it would hold lines back until exit).
    # No hover events or mipmaps: Kindle has no use for the one, and the picture is never scaled
    # down, so the other is wasted work.
    env "${adb_env[@]}" "${server[@]}" SDL_APP_ID="$WINDOW_ID" SCRCPY_ICON_PATH="$KINDLE_ICON" "${big[@]}" \
      stdbuf -oL -eL "$(scrcpy_bin)" --serial="$serial" "${screen[@]}" \
      --start-app="$KINDLE_PKG" --window-title=Kindle --no-audio --no-mouse-hover --no-mipmaps "${extra[@]}" \
      >>"$log" 2>&1 </dev/null 9>&- &
    pid=$!
    started=$SECONDS
    if [[ $mode == sign-in ]]; then
      watch_sign_in "$pid" 9>&- &
    else
      watch_app "$pid" "$log" 9>&- &
    fi
    watcher=$!
    rc=0
    wait "$pid" || rc=$?
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    reopen=$(cat "$STATE_DIR/reopen" 2>/dev/null || true)
    if [[ $reopen == normal ]]; then
      restore_main_screen keep-density
      mode=normal
      notify "Signed in" "Opening your library…"
      continue
    elif [[ $reopen == sign-in ]]; then
      if [[ $BACKEND == waydroid && $(display_mode) == x11 ]]; then
        restore_main_screen
        fail "Amazon didn't finish signing you in." "Run \"$CMD --sign-in\" to try again."
      fi
      # Amazon rejected registration inside the virtual screen (e.g. AuthPortalUIActivity was
      # recreated); fall back to Android's own screen directly instead of looping.
      notify "Amazon didn't finish signing you in" "Opening Amazon's sign-in page in Android's window instead."
      restore_main_screen
      kfl_adb -s "$serial" shell am force-stop "$KINDLE_PKG" >/dev/null 2>&1 || true
      trap - EXIT
      pkill -P "$color_pid" 2>/dev/null || true
      kill "$color_pid" 2>/dev/null || true
      exec 9>&-
      sign_in_window
      return
    fi
    # scrcpy exits with 2 when its link to Android drops. The emulator's adb link (virtio-vsock)
    # can drop for a moment under load, e.g. while a book opens, and comes back within a second
    # with Android and Kindle untouched. Reopen the window then instead of reporting a failure.
    # Only for a window that had been open a while, and a few times at most, so a link that
    # keeps failing still ends in the error below.
    if ((rc == 2)) && [[ $mode == normal ]] && ((SECONDS - started >= 5 && drops < 3)) &&
      serial=$(android_connect 15); then
      drops=$((drops + 1))
      printf '\n[kindle] Lost the connection to Android; reopening the window (%d).\n\n' "$drops" >>"$log"
      continue
    fi
    break
  done
  [[ $mode != sign-in ]] || restore_main_screen # closed before signing in
  # 0 = window closed. Anything else means Android dropped the connection or scrcpy failed.
  ((rc == 0)) || fail "Kindle's window closed unexpectedly." "Details are in ${log/#$HOME/\~}."
}

# Take Kindle to Amazon's sign-in page: its "More" tab, then "Sign In with Amazon". They're found
# by their text in Android's description of the screen (uiautomator), so this works whatever the
# screen's size and layout. 1 if they don't turn up (e.g. already signed in).
# On Waydroid ($2 = waydroid), stop once "Sign In with Amazon" is visible rather than opening
# AuthPortalUIActivity on display 0: moving AuthPortalUIActivity between displays on Android 13
# recreates it, which makes Amazon reject device registration.
open_sign_in_page() { # $1 = serial, [$2 = backend]
  local i found
  for i in $(seq 1 12); do
    if kfl_adb -s "$1" shell dumpsys activity activities 2>/dev/null | grep topResumedActivity | grep -q AuthPortalUIActivity; then
      return 0
    fi
    found=$(ADB_TIMEOUT=20 kfl_adb -s "$1" exec-out uiautomator dump /dev/tty 2>/dev/null | python3 -c '
import re, sys
xml = sys.stdin.read()
def center(want):
    for node in re.findall(r"<node [^>]*>", xml):
        label = " ".join(re.findall(r" (?:text|content-desc)=\"([^\"]*)\"", node)).strip().lower()
        b = re.search(r"bounds=\"\[(\d+),(\d+)\]\[(\d+),(\d+)\]\"", node)
        if b and want(label):
            x1, y1, x2, y2 = map(int, b.groups())
            return f"{(x1 + x2) // 2} {(y1 + y2) // 2}"
for name, want in (("signin", lambda l: l.startswith("sign in with amazon")), ("more", lambda l: l == "more")):
    c = center(want)
    if c:
        print(name, c)
        break
' 2>/dev/null || true)
    case $found in
      signin\ *)
        [[ ${2:-} != waydroid ]] || return 0
        local x y
        read -r _ x y <<<"$found"
        kfl_adb -s "$1" shell input tap "$x" "$y" >/dev/null 2>&1
        ;;
      more\ *)
        local x y
        read -r _ x y <<<"$found"
        kfl_adb -s "$1" shell input tap "$x" "$y" >/dev/null 2>&1
        ;;
    esac
    sleep 2
  done
  return 1
}

# Amazon's sign-in page is marked secure (FLAG_SECURE): Android blanks such windows out of screen
# captures, and Kindle's usual window is one (scrcpy). So signing in happens in a window that
# shows Android's own screen directly: the emulator's own window, or Waydroid's full interface.
# Fallback when Kindle's window can't show the sign-in page (see above).
sign_in_window() {
  mkdir -p "$STATE_DIR"
  if [[ $BACKEND == waydroid && $(display_mode) == x11 ]]; then
    # On X11 Waydroid runs inside a hidden headless cage, so waydroid show-full-ui isn't visible.
    fail "Amazon sign-in needs Kindle's sign-in service on X11." "Run \"$CMD --setup\", then \"$CMD --sign-in\"."
  fi
  local serial launch
  exec 9>"$STATE_DIR/window.lock"
  flock -w 5 9 || fail "Kindle is already open." "Close its window first, then sign in."
  notify "Opening Amazon's sign-in page…" "It opens in a separate window."
  if [[ $BACKEND == emulator ]]; then
    if ! emu_windowed; then
      stop_android
      EMU_WINDOW=1 start_android 240 || fail "Kindle couldn't start Android." "Details are in $STATE_DISPLAY."
    fi
  else
    case $(android_state) in
      STOPPED) start_android 240 || fail "Kindle couldn't start Android." "Details are in $STATE_DISPLAY." ;;
      FROZEN) android_wake ;;
    esac
    setsid -f waydroid show-full-ui >/dev/null 2>&1 </dev/null 9>&-
  fi
  serial=$(android_connect 60) || fail "Kindle can't reach Android." "Run \"$CMD --stop\", then \"$CMD --sign-in\"."
  kfl_adb -s "$serial" shell wm density reset >/dev/null 2>&1 || true
  state_set display0_density ""
  kfl_adb -s "$serial" logcat -c >/dev/null 2>&1 || true
  match_color_scheme "$serial"
  launch=$(kfl_adb -s "$serial" shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$KINDLE_PKG" | tr -d '\r' | tail -n1)
  kfl_adb -s "$serial" shell am start -n "$launch" >/dev/null 2>&1 || true
  if open_sign_in_page "$serial"; then
    notify "Sign in to Amazon" "In the window that just opened. Once you're signed in, it closes and Kindle opens your library."
    echo "Sign in to Amazon in the Android window."
  else
    notify "Sign in to Amazon" "In the window that just opened, open More, then Sign In with Amazon. Already signed in? Just close that window."
    echo "Sign in to Amazon in the Android window (More → Sign In with Amazon)."
  fi
  # Wait for the sign-in: Amazon's page (AuthPortalUIActivity) comes up, and once it's gone again
  # with Kindle back in front and registration settled, the sign-in is done. On the emulator,
  # closing its window also ends this. Gives up after 30 minutes.
  local seen=0 signed_in=0 top i retry reg_err deadline=$((SECONDS + 1800))
  while ((SECONDS < deadline)); do
    if [[ $BACKEND == emulator && -z $(emu_pid) ]]; then break; fi
    top=$(kfl_adb -s "$serial" shell dumpsys activity activities 2>/dev/null | grep topResumedActivity || true)
    if [[ $top == *AuthPortalUIActivity* ]]; then
      seen=1
    elif ((seen)) && [[ $top == *"$KINDLE_PKG/"* && $top != *ThirdPartyUpgradePage* && $top != *TrialModeSignInActivity* ]]; then
      retry=0 reg_err=0
      for i in 1 2 3 4 5 6; do # wait for async device registration before closing/handing off
        if kfl_adb -s "$serial" logcat -d 2>/dev/null | grep -q "AccountManagerLogic: Register error"; then
          reg_err=1
          break
        fi
        sleep 1
        top=$(kfl_adb -s "$serial" shell dumpsys activity activities 2>/dev/null | grep topResumedActivity || true)
        if [[ $top == *AuthPortalUIActivity* ]]; then
          retry=1
          break
        fi
      done
      if ((reg_err)); then
        notify "Amazon didn't finish signing you in" "Please try signing in again in the Android window."
        kfl_adb -s "$serial" logcat -c >/dev/null 2>&1 || true
        seen=0
        continue
      fi
      ((retry)) && continue
      kfl_adb -s "$serial" shell sync >/dev/null 2>&1 || true
      state_set "signed_in_$BACKEND" 1
      signed_in=1
      notify "Signed in" "Opening your library…"
      break
    fi
    sleep 2
  done
  if [[ $BACKEND == emulator ]]; then
    stop_android # its window closes; Kindle's usual window starts it again without one
  elif ((signed_in)); then
    notify "Signed in" "You can close the Android window now."
  fi
  exec 9>&-
  ((!signed_in)) || setsid -f "$here/kindle" >/dev/null 2>&1 </dev/null
}

case ${1:-} in
  --help | -h)
    usage
    ;;
  --version | -V)
    printf 'kindle-for-linux %s\n' "$(kfl_version)"
    ;;
  --setup)
    shift
    run_setup "$@"
    ;;
  --verify)
    shift
    [[ -x $here/verify.sh ]] || die "verify.sh is missing."
    exec "$here/verify.sh" "$@"
    ;;
  --uninstall)
    shift
    [[ -x $here/uninstall.sh ]] || die "uninstall.sh is missing."
    exec "$here/uninstall.sh" "$@"
    ;;
  --sign-in)
    [[ $(display_mode) != none ]] || die "Run this from inside your desktop session."
    if needs_setup; then run_setup; fi
    open_kindle sign-in
    ;;
  --density)
    d=${2:-}
    if [[ $d == reset || $d == auto ]]; then
      state_set density ""
      echo "Kindle density reset to automatic (reopen Kindle to apply)."
    elif [[ $d =~ ^[0-9]+$ && $d -ge 72 && $d -le 640 ]]; then
      state_set density "$d"
      echo "Kindle density set to $d (default at 1x display scale is 160; reopen Kindle to apply)."
    else
      die "Usage: $CMD --density <72-640|reset>"
    fi
    ;;
  --stop)
    [[ -n $(state_get backend) ]] || exit 0
    stop_android
    kfl_adb kill-server >/dev/null 2>&1 || true
    ;;
  --status)
    if needs_setup; then
      printf 'Not set up yet. Run "%s --setup" to install Android and Kindle.\n' "$CMD"
    else
      printf 'Android (%s): %s\n' "$BACKEND" "$(android_state)"
    fi
    ;;
  "")
    [[ $(display_mode) != none ]] || die "Run this from inside your desktop session."
    if needs_setup; then run_setup; fi
    if [[ $BACKEND == waydroid && $(display_mode) == x11 ]]; then
      command -v cage >/dev/null || fail "Kindle isn't fully installed." "cage, needed on X11 desktops, is missing. Run \"$CMD --setup\"."
    fi
    open_kindle auto
    ;;
  *) die "unknown option: $1 (try --help)" ;;
esac
