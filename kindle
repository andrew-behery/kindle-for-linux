#!/usr/bin/env bash
# Open Kindle in its own window.
#   kindle           open Kindle (the first open after login starts Android in the background)
#   kindle --stop    shut Android down and free its memory
#   kindle --status  show whether Android is running, frozen or stopped
# The window is scrcpy showing a virtual Android screen that resizes with it, so Kindle reflows
# when the window is tiled, resized or made fullscreen. While the window is closed, Android stays
# loaded but frozen (no CPU use), so Kindle reopens in about a second.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
# shellcheck source=lib.sh
source "$here/lib.sh"

notify() { if command -v notify-send >/dev/null; then notify-send -a Kindle "$@" || true; fi; }
fail() {
  notify -u critical Kindle "$*"
  die "$*"
}

command -v waydroid >/dev/null || fail "Waydroid isn't installed. Run install.sh again."
[[ -n $(scrcpy_bin) && -n $(adb_bin) ]] || fail "scrcpy isn't installed. Run install.sh again."

open_kindle() {
  mkdir -p "$STATE_DIR"
  local log=$STATE_DIR/window.log serial rc=0
  # One Kindle window at a time: a second one would open a second virtual screen. Waiting a few
  # seconds lets a window that is just closing finish (it freezes Android on its way out).
  exec 9>"$STATE_DIR/window.lock"
  flock -w 5 9 || exit 0

  if [[ $(session_state) != RUNNING ]]; then
    notify Kindle "Starting Android…"
    start_android 180 || fail "Android didn't start within 3 minutes. Details: $STATE_DIR/session.log"
  elif [[ $(container_state) == FROZEN ]]; then
    container_call Unfreeze || true
  fi
  if ! serial=$(android_connect 15); then
    # Android is up but unreachable: after its core restarts (a crash), it can come back without
    # its network. A fresh start fixes that.
    notify Kindle "Restarting Android…"
    stop_android
    start_android 180 || fail "Android didn't restart. Details: $STATE_DIR/session.log"
    serial=$(android_connect 60) || fail "Can't reach Android. Try: kindle --stop, then open Kindle again."
  fi
  hide_waydroid_entry
  # Waydroid sets Android's density to 180 × the display's scale factor (an override set with
  # `wm density` wins). scrcpy would otherwise give its screen 160, too small on scaled displays.
  local density
  density=$(kfl_adb -s "$serial" shell wm density 2>/dev/null | tr -d '\r' |
    awk -F': ' '/^Override/ { o = $2 } /^Physical/ { p = $2 } END { print (o ? o : p) }')
  [[ $density =~ ^[0-9]+$ ]] || density=180

  # Freeze Android once the window closes. The pause lets scrcpy finish removing its screen.
  trap 'sleep 2; container_call Freeze || true' EXIT
  local server=()
  [[ -f $SCRCPY_DIR/scrcpy-server ]] && server=(SCRCPY_SERVER_PATH="$SCRCPY_DIR/scrcpy-server")
  # SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY sizes the window in real pixels, so on a scaled display
  # Android draws at full resolution (sharp text) at the density Waydroid derived from the scale.
  env ADB="$(adb_bin)" "${server[@]}" SDL_APP_ID="$WINDOW_ID" SCRCPY_ICON_PATH="$KINDLE_ICON" \
    SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1 \
    "$(scrcpy_bin)" --serial="$serial" --new-display=/"$density" --flex-display --start-app="$KINDLE_PKG" \
    --window-title=Kindle --no-audio >"$log" 2>&1 </dev/null 9>&- || rc=$?
  # 0 = window closed. Anything else means Android dropped the connection or scrcpy failed.
  ((rc == 0)) || fail "Kindle's window closed unexpectedly. Details: $log"
}

case ${1:-} in
  --stop)
    kfl_adb kill-server >/dev/null 2>&1 || true
    stop_android
    ;;
  --status)
    printf 'Android session: %s\nContainer:       %s\n' "$(session_state)" "$(container_state)"
    ;;
  "")
    [[ $(display_mode) != none ]] || die "Run this from inside your desktop session."
    if [[ $(display_mode) == x11 ]]; then
      command -v cage >/dev/null || fail "cage is needed on X11 desktops. Run install.sh again."
    fi
    open_kindle
    ;;
  *) die "unknown option: $1 (try --stop or --status)" ;;
esac
