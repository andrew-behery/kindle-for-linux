# Maintainer: Andrew Behery <andrewbehery@gmail.com>
pkgname=kindle-for-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="The real Kindle Android app on Linux, in its own resizable window"
arch=('any')
url="https://github.com/andrew-behery/kindle-for-linux"
license=('MIT' 'Apache-2.0')
depends=('bash' 'python' 'curl' 'unzip' 'coreutils' 'util-linux' 'procps-ng' 'gawk')
optdepends=(
  'waydroid: Android container backend for AMD/Intel/ARM GPUs'
  'cage: hidden Wayland compositor for Waydroid on X11 desktops'
  'libnotify: desktop notifications'
  'xdg-utils: Downloads folder lookup for manual APK installs'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local lib="$pkgdir/usr/share/$pkgname"
  install -Dm 644 VERSION "$lib/VERSION"
  install -Dm 755 kindle install.sh uninstall.sh verify.sh apkcert.py getkindle.py -t "$lib"
  install -Dm 644 lib.sh apkicon.py -t "$lib"
  install -Dm 644 scrcpy-server/scrcpy-server-secure scrcpy-server/kfl-scrcpy.rc -t "$lib/scrcpy-server"
  install -Dm 755 scrcpy-server/adb-system scrcpy-server/kfl-scrcpy-server -t "$lib/scrcpy-server"

  install -d "$pkgdir/usr/bin"
  ln -s "/usr/share/$pkgname/kindle" "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 packaging/kindle-for-linux.desktop "$pkgdir/usr/share/applications/kindle-for-linux.desktop"
  install -Dm 644 packaging/kindle-for-linux.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/kindle-for-linux.svg"
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm 644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
